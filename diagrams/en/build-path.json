  "cards": [
    {
      "dot": "cyan",
      "title": "Configuration ownership",
      "items": [
        "The default build derives configuration from Cargo features. An LVGL_CONFIG_PATH header is included unchanged and validated.",
        "C compilation and bindgen must agree on target configuration; Rust visibility alone is insufficient."
      ]
    },
    {
      "dot": "emerald",
      "title": "Use the linked provider",
      "items": [
        "rs_lvgl/build.rs reads DEP_LVGL_BINDINGS and capability metadata before writing generated.rs.",
        "Only missing BINDINGS metadata selects the build-dependency bindings. The platform still supplies display, input and timing."
      ]
    }
  ]
